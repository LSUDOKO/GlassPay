# glasspay server (packages/server)
GLASSPAY_MASTER_KEY=          # required: 64 hex chars (32 bytes); encrypts agent keys + card secrets at rest
GLASSPAY_ADMIN_TOKEN=         # ops lane: bearer token with FULL access to the management API (/api/*) — server-side curl/scripts only
GLASSPAY_PRIVY_APP_ID=        # dashboard lane: enables per-user auth (Privy access tokens verified against this app's JWKS)
PORT=4070
GLASSPAY_DB_PATH=.dev/glasspay.sqlite
GLASSPAY_RPC_URL=https://mainnet.base.org
GLASSPAY_PUBLIC_MCP_BASE=     # public origin used when rendering card URLs, e.g. https://api.example.com (also arms the MCP Host allowlist; unset = localhost)
GLASSPAY_ALLOWED_HOSTS=       # extra Host headers accepted on /mcp + /c/<secret>/mcp (comma-separated)
GLASSPAY_CORS_ORIGINS=        # comma-separated allowed origins for the API, e.g. https://app.example.com
GLASSPAY_DEV_USER_PK=         # dev only: server-custodied user key for the server-signed issuance lane
GLASSPAY_FACILITATOR_BASE=    # x402 facilitator base URL (defaults to this server)
GLASSPAY_SELLER_PAYTO=        # payout address for the built-in demo seller
GLASSPAY_PAID_FETCH_ALLOW_LOCAL=  # set to 1 to let paid_fetch hit local/private hosts (dev only)
GLASSPAY_STRIPE_WEBHOOK_SECRET=   # Stripe real-time auth webhook signing secret (test mode); unset = fiat leg disabled (503)
STRIPE_SECRET_KEY=             # Stripe TEST-mode secret key (sk_test_/rk_test_ ONLY; anything else is refused); enables the fiat trigger + card credential tools
GLASSPAY_FIAT_SETTLEMENT=         # set to 1: approved Visa charges settle on-chain as real delegated USDC transfers to the settlement address
GLASSPAY_SETTLEMENT_ADDRESS=      # settlement recipient for the fiat leg; defaults to the fee collector
GLASSPAY_DASHBOARD_BASE=          # dashboard origin hosting the OAuth consent page, e.g. https://app.example.com (default http://localhost:4071)
# Optional tuning (defaults apply when unset; uncomment to override):
#GLASSPAY_RECONCILE_INTERVAL_MS=300000   # stuck-pending-charge reconcile sweep interval, ms (0 disables)
#GLASSPAY_FIAT_FEE_HEADROOM=0.02         # USDC reserved for the settlement fee in the authorization decision (settlement mode only; live relayer minFee ~0.011)
#GLASSPAY_FIAT_SETTLE_INTERVAL_MS=60000  # unsettled fiat charge sweep interval, ms
#GLASSPAY_MCP_RATE_LIMIT=240             # per-card MCP request ceiling per minute
#GLASSPAY_MCP_BAD_SECRET_LIMIT=30        # per-IP bad-credential attempt ceiling per minute
#GLASSPAY_OAUTH_ACCESS_TTL=3600          # OAuth access-token lifetime, seconds
#GLASSPAY_OAUTH_REFRESH_TTL=2592000      # OAuth refresh-token lifetime, seconds (30 days)
#GLASSPAY_OAUTH_REDIRECT_HOSTS=          # if set, restrict https redirect-uri hosts to this comma-separated allowlist (recommended in prod; loopback + custom schemes always allowed)
#GLASSPAY_OAUTH_ACCEPTED_RESOURCES=      # extra RFC 8707 resource URIs still honored (legacy values during a base-URL migration; comma-separated)
#GLASSPAY_OAUTH_REGISTER_LIMIT=10        # per-IP client-registration ceiling per minute
#GLASSPAY_OAUTH_AUTHORIZE_LIMIT=30       # per-IP authorize-request ceiling per minute
#GLASSPAY_OAUTH_TOKEN_LIMIT=60           # per-IP token/revoke-request ceiling per minute
#GLASSPAY_TRUST_PROXY_HOPS=1             # trusted proxy hops for client-IP rate-limiting (Railway=1; CDN+Railway=2; 0 disables XFF trust)

# glasspay dashboard (packages/dashboard)
# The dashboard authenticates as the USER: every API call carries the Privy session
# token, verified server-side. No admin token ever reaches the browser.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_GLASSPAY_API=http://localhost:4070/api
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org

# OpenTelemetry (SigNoz) - see casting.yaml for local deployment
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
GLASSPAY_OTEL_DEBUG=0
